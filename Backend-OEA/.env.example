# Copia este archivo como ".env" y reemplaza los valores por los reales.

# URL de conexión a la base de datos de Supabase.
# La encuentras en: Supabase → tu proyecto → Project Settings → Database
# → "Connection string" → modo "Transaction" (puerto 6543) para producción,
# o modo "Session" (puerto 5432) para desarrollo local.
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Puerto en el que corre la API (Render/Railway lo asignan automáticamente,
# no hace falta tocarlo en producción).
PORT=3000

# Dominios permitidos para hacer peticiones a esta API (CORS),
# separados por coma. Incluye el dominio real del sitio cuando lo tengan.
CORS_ORIGINS="http://localhost:8080,http://localhost"

# Clave requerida por los endpoints administrativos de matrículas.
ADMIN_API_KEY="reemplaza-por-una-clave-secreta-larga"
